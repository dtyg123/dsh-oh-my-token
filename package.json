{
  "name": "dsh-oh-my-token",
  "version": "0.0.1",
  "description": "DeepSeek Harness 原生省 Token 插件：命令输出过滤、RTK 结构压缩、检索式读取、客套词与句末标点清理、系统提示词编辑，以及一个可调全部配置并报告节省量的设置页。纯 JS，无 RTK 二进制、无 codegraph 服务。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "bin": {
    "oh-my-token": "./bin/oh-my-token.js",
    "dsh-oh-my-token": "./bin/oh-my-token.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check bin/oh-my-token.js",
    "test": "node --test",
    "verify": "npm run check && npm test"
  },
  "meta": {
    "title": "Oh My Token",
    "description": "在源头压缩命令输出，把超大的 read 变成符号大纲，清理散文里的客套词与句末标点，并可追加或替换系统提示词。每个变换在同一个设置页都有开关，页面还会报告实际省下的字符。"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "tokens",
    "context",
    "compression"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtyg123/dsh-oh-my-token.git"
  },
  "homepage": "https://github.com/dtyg123/dsh-oh-my-token#readme",
  "bugs": {
    "url": "https://github.com/dtyg123/dsh-oh-my-token/issues"
  }
}
